{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SurSplit: run server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000", "--reload", "--reload-dir", "app"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "SurSplit: download models",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/download_models.py",
      "cwd": "${workspaceFolder}"
    }
  ]
}
