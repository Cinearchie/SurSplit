# Copy this file to ".env" and adjust. Every value here is optional.

# ---- Server ----
HOST=127.0.0.1           # use 0.0.0.0 to accept connections from other devices / when hosting
PORT=8000

# ---- Storage ----
DATA_DIR=data            # temporary job files
MODEL_DIR=models         # downloaded AI models (~60 MB for "hq", ~640 MB for "best")

# ---- Access ----
APP_PASSWORD=            # set a password to lock the whole site (browser login box, any username)

# ---- Features ----
ENABLE_YOUTUBE=true      # paste-a-link mode
ENABLE_UPLOAD=true       # upload-a-file mode
YOUTUBE_HELPER_URL=https://audiotranscriber.io/youtube-to-mp3/   # shown when ENABLE_YOUTUBE=false; empty hides the helper tab
ENABLED_MODELS=hq,best   # hq = MDX-Net Inst HQ 4 (fast, great); best = BS-RoFormer (needs a GPU to be practical)
DEFAULT_MODEL=hq

# ---- Limits (important when public) ----
MAX_DURATION_SECONDS=600     # 10 minutes
MAX_UPLOAD_MB=100
MAX_CONCURRENT_JOBS=1        # separations running at the same time; keep 1 on small CPUs
MAX_QUEUE_SIZE=20            # total jobs waiting + running
MAX_ACTIVE_JOBS_PER_IP=2
JOB_TTL_MINUTES=120          # results are deleted after this

# Set true when behind Nginx / Cloudflare / Render / Hugging Face, so per-IP limits see the real visitor IP
TRUST_PROXY=false

# ---- YouTube on cloud servers ----
# YouTube often blocks datacenter IPs with "Sign in to confirm you're not a bot".
# Export cookies from a (throwaway) logged-in browser as cookies.txt and point to it:
YTDLP_COOKIES=

# ---- Output quality (defaults = identical to the original run) ----
NORMALIZATION=0.9
MP3_BITRATE=320k
